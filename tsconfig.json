{
    "compilerOptions": {
        "noUnusedLocals": true,
        "noImplicitAny": true,
        "noEmit": true,
        "target": "ESNext",
        "allowJs": true,
        "checkJs": false,
        "strict": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "types": [
            "@girs/gjs",
            "@girs/gnome-shell/ambient"
        ]
    }
}
